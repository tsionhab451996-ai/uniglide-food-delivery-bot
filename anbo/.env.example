# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Telegram Admin User IDs (comma-separated integers)
ADMIN_IDS=8807112922,5122994050,1947975174

# Database Path (automatically creates parent directory if needed)
DB_PATH=data/bot_database.db

# Payment Account Details (Telebirr & CBE)
TELEBIRR_NUMBER=0945956296
CBE_ACCOUNT=1000152786283
ACCOUNT_HOLDER_NAME=Tsion Habtamu

# Optional: Telegram Dispatch Channel or Group ID (e.g., -1001234567890 or @kitchen_channel)
DISPATCH_CHANNEL_ID=

# Optional: Google Gemini AI API Key for assistant
GEMINI_API_KEY=
